# Configuración de base de datos y tokens
DATABASE_URL=sqlite:///university_news.db
ADMIN_TOKEN=cambiar_por_token_admin_seguro_min_32_caracteres
COLLECTOR_TOKEN=cambiar_por_token_collector_seguro_min_32_caracteres
ALLOWED_ORIGINS=["http://localhost:4321","http://localhost:8080","http://127.0.0.1:4321"]

# OpenRouter (opcional para Chat / RAG)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=UniNews
RAG_ENABLED=true
RAG_MAX_DISTANCE=0.95
